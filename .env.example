# Optional local overrides for build-time constants (read by scripts/build-lib.mjs).
# Defaults come from wrangler.jsonc "vars"; real environment variables win.
# Copy to `.env` (gitignored) only if you need local overrides.
#
# API_URL=http://localhost:8000
# API_PREFIX=api/v1
# MOCK_AUTH=false          # "true" only for UI work without a backend (dev builds)
# API_BASE_URL=https://backend.example.com  # overrides API_URL entirely
# WS_URL=                  # empty = same origin (/ws/ through the edge proxy)
#
# Never put the real backend host here: it is a Cloudflare secret (BACKEND_HOST).
