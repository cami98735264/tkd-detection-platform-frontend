# Local dev secrets for `wrangler dev` (and `wrangler pages dev`).
# Copy to `.dev.vars` (gitignored) and fill in real values.
#
# BACKEND_HOST: origin host the edge reverse-proxy (src/index.ts and
# functions/_middleware.ts) forwards /api, /ws and /media to. In production this
# is an ENCRYPTED SECRET set in the Cloudflare dashboard (Pages project →
# Settings → Variables and Secrets), never committed. For local dev, copy this
# file to `.dev.vars` (gitignored) and put the real host below.
BACKEND_HOST=backend.example.com
# ORIGIN_SECRET: shared secret sent as X-Origin-Auth. Must equal ORIGIN_SECRET in
# the backend's .env — its nginx drops requests without it. Also an encrypted
# secret on the Pages project in production.
ORIGIN_SECRET=your-origin-secret
